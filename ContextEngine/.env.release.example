# Copy this file to .env.release.local and keep every value shell-quoted.
# .env.release.local and .release-secrets/ are ignored by Git.

# Google Play upload signing — required by npm run android:release.
CONTEXTENGINE_UPLOAD_STORE_FILE='/absolute/path/to/context-engine-upload.jks'
CONTEXTENGINE_UPLOAD_STORE_PASSWORD=''
CONTEXTENGINE_UPLOAD_KEY_ALIAS=''
CONTEXTENGINE_UPLOAD_KEY_PASSWORD=''

# Apple Distribution signing — import once with:
# npm run release:import-apple-credentials
CONTEXTENGINE_APPLE_DISTRIBUTION_P12='/absolute/path/to/apple-distribution.p12'
CONTEXTENGINE_APPLE_DISTRIBUTION_P12_PASSWORD=''
CONTEXTENGINE_APPLE_PROVISIONING_PROFILE='/absolute/path/to/ContextEngine_AppStore.mobileprovision'

# Publisher and store metadata — used by docs/privacy-policy.md and docs/store-submission-package.md.
CONTEXTENGINE_PUBLISHER_LEGAL_NAME=''
CONTEXTENGINE_SUPPORT_EMAIL=''
CONTEXTENGINE_SUPPORT_URL=''
CONTEXTENGINE_PRIVACY_POLICY_URL=''
CONTEXTENGINE_MARKETING_URL=''
CONTEXTENGINE_AVAILABILITY_REGIONS=''
CONTEXTENGINE_TARGET_AUDIENCE=''

# Optional API credentials for future automated store upload.
CONTEXTENGINE_APP_STORE_CONNECT_KEY_ID=''
CONTEXTENGINE_APP_STORE_CONNECT_ISSUER_ID=''
CONTEXTENGINE_APP_STORE_CONNECT_PRIVATE_KEY='/absolute/path/to/AuthKey_KEYID.p8'
CONTEXTENGINE_PLAY_SERVICE_ACCOUNT_JSON='/absolute/path/to/google-play-service-account.json'
