<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/quick_capture_write_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/quick_capture_write_title"
                android:textColor="@color/tn_color_on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quick_capture_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/quick_capture_write_close"
                android:focusable="true"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/tn_color_on_surface_variant"
                android:textSize="26sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/quick_capture_input"
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/quick_capture_input_background"
            android:contentDescription="@string/quick_capture_input_description"
            android:gravity="top|start"
            android:hint="@string/quick_capture_write_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="14dp"
            android:scrollbars="vertical"
            android:textColor="@color/tn_color_on_surface"
            android:textColorHint="@color/tn_color_on_surface_variant"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/quick_capture_save"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/quick_capture_widget_record_action"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/quick_capture_write_save"
            android:textColor="@color/quick_capture_widget_write_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quick_capture_permission_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quick_capture_mic_title"
            android:textColor="@color/tn_color_on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/quick_capture_mic_message"
            android:textColor="@color/tn_color_on_surface_variant"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/quick_capture_mic_denied"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/quick_capture_mic_denied"
            android:textColor="@color/tn_color_error"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/quick_capture_mic_continue"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/quick_capture_widget_record_action"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/quick_capture_mic_continue"
            android:textColor="@color/quick_capture_widget_write_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
