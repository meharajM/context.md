<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/quick_capture_widget_surface"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="4dp">

    <Button
        android:id="@+id/quick_capture_widget_button"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:contentDescription="@string/quick_capture_widget_type_description"
        android:background="@drawable/quick_capture_widget_write_action"
        android:clickable="true"
        android:drawableStart="@drawable/quick_capture_widget_write_icon"
        android:drawablePadding="4dp"
        android:ellipsize="end"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/quick_capture_widget_button"
        android:textAllCaps="false"
        android:textColor="@color/quick_capture_widget_write_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <Button
        android:id="@+id/quick_record_widget_button"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:contentDescription="@string/quick_record_widget_description"
        android:background="@drawable/quick_capture_widget_record_action"
        android:clickable="true"
        android:drawableStart="@drawable/quick_capture_widget_record_icon"
        android:drawablePadding="4dp"
        android:ellipsize="end"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/quick_record_widget_button"
        android:textAllCaps="false"
        android:textColor="@color/quick_capture_widget_record_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1" />
</LinearLayout>
