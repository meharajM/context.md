<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/quick_capture_widget_record_pressed" />
            <stroke android:width="1dp" android:color="@color/quick_capture_widget_record_outline" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/quick_capture_widget_record" />
            <stroke android:width="1dp" android:color="@color/quick_capture_widget_record_outline" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
