{
  "name": "ContextEngine",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:check-16k": "node scripts/check-android-16k.js",
    "android:release": "scripts/with-release-env.sh sh -c 'cd android && ./gradlew app:bundleRelease'",
    "ios": "react-native run-ios --verbose --simulator \"iPhone 16\" --no-packager",
    "ios:device": "react-native run-ios --device --verbose --no-packager",
    "ios:release": "scripts/build-ios-release.sh",
    "lint": "eslint --resolve-plugins-relative-to node_modules/@react-native/eslint-config .",
    "postinstall": "node scripts/fix-whisper-rn-codegen.js && node scripts/strip-unused-rnfs-disk-api.js",
    "release:apply-metadata": "scripts/with-release-env.sh node scripts/apply-release-metadata.js",
    "release:import-apple-credentials": "scripts/import-apple-distribution.sh",
    "release:preflight": "scripts/with-release-env.sh node scripts/release-preflight.js",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "validate:regression": "npm run typecheck -- --pretty false && npm test -- --runInBand",
    "validate:current-phase": "node scripts/validate-current-phase.js",
    "update-status": "node scripts/update-status.js",
    "test:e2e": "npm run test:e2e:ios",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "test:e2e:android": "detox test --configuration android.emu.debug",
    "test:e2e:build:ios": "detox build --configuration ios.sim.debug",
    "test:e2e:build:android": "detox build --configuration android.emu.debug",
    "store:screenshots:ios": "node scripts/ensure-ios-store-simulator.js iphone && STORE_SCREENSHOT_DEVICE_CLASS=iphone CAPTURE_STORE_SCREENSHOTS=1 detox test --configuration ios.store.debug e2e/store-screenshots.test.js --cleanup",
    "store:screenshots:ios:ipad": "node scripts/ensure-ios-store-simulator.js ipad && STORE_SCREENSHOT_DEVICE_CLASS=ipad CAPTURE_STORE_SCREENSHOTS=1 detox test --configuration ios.store.ipad.debug e2e/store-screenshots.test.js --cleanup",
    "store:screenshots:android": "STORE_SCREENSHOT_DEVICE_CLASS=phone CAPTURE_STORE_SCREENSHOTS=1 detox test --configuration android.emu.debug e2e/store-screenshots.test.js --cleanup",
    "qa:real-device": "node scripts/real-device-qa.js"
  },
  "dependencies": {
    "@fugood/react-native-audio-pcm-stream": "^1.1.4",
    "@react-native/new-app-screen": "0.84.1",
    "buffer": "^6.0.3",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-fs": "^2.20.0",
    "react-native-permissions": "^5.5.1",
    "react-native-safe-area-context": "^5.5.2",
    "whisper.rn": "^0.5.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@jest/reporters": "^29.7.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@types/jest": "^29.5.13",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "detox": "20.50.4",
    "eslint": "^8.19.0",
    "eslint-plugin-jest": "^29.15.2",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
